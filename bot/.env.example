# Telegram — 从 @BotFather 获取
TELEGRAM_TOKEN=

# OpenRouter — 从 https://openrouter.ai/keys 获取
OPENROUTER_API_KEY=

# 模型（可选）
# 默认：anthropic/claude-sonnet-4.6（推荐，质量高，价格适中）
# 更强：anthropic/claude-opus-4.6（写作质量最高，价格约 5 倍）
# 更快：anthropic/claude-haiku-4.5（速度最快，价格最低）
# 其他可用模型见 https://openrouter.ai/models?q=claude
# MODEL=anthropic/claude-sonnet-4.6

# GitHub Personal Access Token (需要 repo 权限)
# 从 https://github.com/settings/tokens 创建
GITHUB_TOKEN=

# 目标仓库（owner/repo 格式）
GITHUB_REPO=Ssssure/claude-XR-knowledge-base

# 可选：限制哪些 Telegram 用户可以使用，逗号分隔用户 ID
# 不填则允许所有人（不推荐公开部署时留空）
ALLOWED_TELEGRAM_USERS=
